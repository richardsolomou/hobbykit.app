// HobbyKit magnetised movement tray, for MakerWorld's Parametric Model Maker.
// A port of src/core/geometry/movementTray.ts: change both together, then run `just makerworld check`.
// The tray prints the way it is used: z = 0 is the face on the table, the slots open upward,
// and the magnet pockets open into the slot floors, so nothing needs supports.
// Licensed under CC BY-SA 4.0, unlike the AGPL-3.0-only app, because MakerWorld offers no GPL licence.

/* [Unit] */
// Pick a standard base size, or Custom to use the shape and dimensions below.
standard_size = "rect-25x25"; // [custom:Custom, round-25:Round 25mm - Guardsmen & Gretchin & Kabalite Warriors, round-28.5:Round 28.5mm - Guardians & Kasrkin & Freeguild Fusiliers, round-32:Round 32mm - Intercessors & Necron Warriors & Ork Boyz, round-40:Round 40mm - Terminators & Custodian Guard & Captains, round-50:Round 50mm - Centurions & Obliterators & Kroxigor, round-60:Round 60mm - Dreadnoughts & Daemon Princes & Stormfiends, round-80:Round 80mm - Avatar of Khaine & Ghazghkull & Slann, round-90:Round 90mm - Redemptor and Brutalis Dreadnoughts, round-100:Round 100mm - Armiger Knights & Repulsor & Greater Daemons, round-120:Round 120mm - Wazdakka Gutsmek, round-130:Round 130mm - Great Unclean One & Onager & Nagash, round-160:Round 160mm - Monolith & Defilers & Archaon, rect-20x20:Rectangle 20×20mm - Kings of War Infantry, rect-25x25:Rectangle 25×25mm - Old World infantry & KoW Heavy Infantry, rect-30x30:Rectangle 30×30mm - Old World Orcs & Chaos Warriors & Saurus, rect-25x50:Rectangle 25×50mm - Old World light cavalry & KoW Cavalry, rect-30x60:Rectangle 30×60mm - Old World knights and cavalry, rect-40x40:Rectangle 40×40mm - Ogres & Trolls & KoW Large Infantry, rect-40x60:Rectangle 40×60mm - Old World Pegasus Knights, rect-50x50:Rectangle 50×50mm - Minotaurs & KoW Large Cavalry and Monsters, rect-50x75:Rectangle 50×75mm - Old World Demigryphs and cannons, rect-50x100:Rectangle 50×100mm - Old World and KoW chariots, rect-60x100:Rectangle 60×100mm - Old World Steam Tank & Griffons & Dragons, rect-75x75:Rectangle 75×75mm - Kings of War Titans, rect-100x150:Rectangle 100×150mm - Old World Terrorgheist & Zombie Dragon]
// Used only with a custom size.
shape = "rect"; // [rect:Rectangle, round:Round]
// Custom size: the diameter of a round base, the frontage of a rectangular one.
width = 25; // [10:0.5:120]
// Custom size: the depth of a rectangular base, front to back.
depth = 25; // [10:0.5:120]
// Corner rounding of rectangular bases. 0 picks it from the size.
corner_radius = 0; // [0:0.5:12]
// Bases across the frontage.
columns = 5; // [1:1:10]
ranks = 4; // [1:1:10]

/* [Slots] */
slot_depth = 2; // [0.5:0.5:6]
// Added to each base so a unit drops in without binding.
slot_clearance = 0.5; // [0:0.1:2]

/* [Construction] */
// Material under the slots. Must cover the magnet pocket plus 0.6mm.
floor_thickness = 3; // [0.6:0.1:10]
// Wall left around the recess.
rim_width = 3; // [1.2:0.5:10]

/* [Magnets] */
// Pockets under every slot, matching the base pattern so magnetised bases land on magnets.
slot_magnets = true;
magnet_diameter = 5; // [2:0.5:8]
magnet_thickness = 2; // [0.5:0.1:5]
// Auto picks the same count as a base of this size.
magnets_per_base = "auto"; // [auto:Auto, 0, 1, 2, 3, 4, 5, 6, 8]
// The five-pocket cross needs a round base of 50mm or more.
pocket_layout = "balanced"; // [balanced:Balanced, five-cross:Five-pocket cross]

/* [Fit & Detail] */
magnet_diameter_clearance = 0.2; // [0:0.05:0.6]
// Room under each magnet for adhesive.
magnet_depth_clearance = 0.1; // [0:0.05:0.5]
// Wall thickness of the bases going in, which sets where their magnets sit.
base_wall_thickness = 2; // [1:0.1:6]
// Wall around each magnet pocket in the bases, which also sets where their magnets sit.
base_wall_around_pocket = 0.9; // [0.4:0.1:3]

/* [Hidden] */
LABEL_MARGIN = 0.8;
MAX_MAGNETS = 8;
MIN_FLOOR_THICKNESS = 0.6;
MIN_RIM = 1.2;
// Three nozzle widths, so neighbouring round slots never meet at a tangent point.
ROUND_SLOT_WEB = 1.2;
EXPORT_CURVE_TOLERANCE = 0.001;
MAGNET_PITCH = 31;
END_PAIR_PITCHES = 3;
SINGLE_MAGNET_MAX_SPAN = MAGNET_PITCH * 2;
RING_COUNTS = [3, 4, 5, 6, 8];
ROW_COUNTS = [4, 6, 8];
ROW_LIMIT_COUNTS = [1, 2, 4, 6, 8];
DEFAULT_MAGNET_STRENGTH = 5 ^ 2 * 2;

// <generated by scripts/makerworld.ts: sizes:round,rect>
// [key, shape, width, length]
SIZES = [
  ["round-25", "round", 25, 25],
  ["round-28.5", "round", 28.5, 28.5],
  ["round-32", "round", 32, 32],
  ["round-40", "round", 40, 40],
  ["round-50", "round", 50, 50],
  ["round-60", "round", 60, 60],
  ["round-80", "round", 80, 80],
  ["round-90", "round", 90, 90],
  ["round-100", "round", 100, 100],
  ["round-120", "round", 120, 120],
  ["round-130", "round", 130, 130],
  ["round-160", "round", 160, 160],
  ["rect-20x20", "rect", 20, 20],
  ["rect-25x25", "rect", 25, 25],
  ["rect-30x30", "rect", 30, 30],
  ["rect-25x50", "rect", 25, 50],
  ["rect-30x60", "rect", 30, 60],
  ["rect-40x40", "rect", 40, 40],
  ["rect-40x60", "rect", 40, 60],
  ["rect-50x50", "rect", 50, 50],
  ["rect-50x75", "rect", 50, 75],
  ["rect-50x100", "rect", 50, 100],
  ["rect-60x100", "rect", 60, 100],
  ["rect-75x75", "rect", 75, 75],
  ["rect-100x150", "rect", 100, 150],
];
// </generated>

CUSTOM = standard_size == "custom";
SIZE = CUSTOM ? undef : let(found = [for (s = SIZES) if (s[0] == standard_size) s]) assert(len(found) == 1, str("Unknown standard size ", standard_size)) found[0];
SHAPE = CUSTOM ? shape : SIZE[1];
ROUND = SHAPE == "round";
WIDTH = CUSTOM ? width : SIZE[2];
LENGTH = ROUND ? WIDTH : CUSTOM ? depth : SIZE[3];
CORNER_RADIUS = ROUND ? 0 : corner_radius > 0 ? corner_radius : min(2, min(WIDTH, LENGTH) * 0.06);
COLUMNS = max(1, round(columns));
RANKS = max(1, round(ranks));

POCKET_DEPTH = magnet_thickness + magnet_depth_clearance;
HEIGHT =
  assert(slot_depth > 0, "Slots need a positive depth")
  assert(floor_thickness >= (slot_magnets ? POCKET_DEPTH : 0) + MIN_FLOOR_THICKNESS - 1e-9, "Tray floor leaves too little material below the magnet pockets")
  assert(rim_width >= MIN_RIM - 1e-9, "Tray rim is too narrow to print")
  floor_thickness + slot_depth;

// Rectangular bases share one recess so a rank keeps base contact; round bases each get a slot.
SLOT_WIDTH = WIDTH + slot_clearance;
SLOT_LENGTH = LENGTH + slot_clearance;
WEB = ROUND ? ROUND_SLOT_WEB : 0;
PITCH = [SLOT_WIDTH + WEB, SLOT_LENGTH + WEB];
RECESS = [COLUMNS * PITCH[0] - WEB, RANKS * PITCH[1] - WEB];
TRAY = RECESS + [2, 2] * rim_width;
SLOTS = [for (r = [0:RANKS - 1]) for (c = [0:COLUMNS - 1]) [(c - (COLUMNS - 1) / 2) * PITCH[0], (r - (RANKS - 1) / 2) * PITCH[1]]];

function segments_for_tolerance(diameter, tolerance) = diameter / 2 <= tolerance ? 3 : ceil(180 / acos(1 - tolerance / (diameter / 2)));
EXPORT_SEGMENTS = segments_for_tolerance(max(TRAY), EXPORT_CURVE_TOLERANCE);
TOLERANCE = max(TRAY) / 2 * (1 - cos(180 / EXPORT_SEGMENTS));
// The app keeps a floor on segment counts while its overall count is in preview range.
function segments_for(diameter, minimum) = max(EXPORT_SEGMENTS <= 256 ? minimum : 3, segments_for_tolerance(diameter, TOLERANCE));

// Outlines as counter-clockwise polygons, vertex for vertex what Manifold builds.
function circle_points(r, n) = [for (i = [0:n - 1]) [r * cos(360 * i / n), r * sin(360 * i / n)]];
function rect_points(w, l, radius, n) =
  radius <= 0 ? [[w / 2, -l / 2], [w / 2, l / 2], [-w / 2, l / 2], [-w / 2, -l / 2]]
  : let(k = max(1, ceil(n / 4)), cx = w / 2 - radius, cy = l / 2 - radius)
    [for (q = [0:3]) let(sx = q == 0 || q == 3 ? 1 : -1, sy = q < 2 ? 1 : -1)
      for (j = [0:k]) let(a = 90 * q + 90 * j / k) [sx * cx + radius * cos(a), sy * cy + radius * sin(a)]];

RECESS_RADIUS = ROUND ? SLOT_WIDTH / 2 : max(0, min(CORNER_RADIUS + slot_clearance / 2, min(RECESS) / 2 - 0.01));
TRAY_RADIUS = min(RECESS_RADIUS + rim_width, min(TRAY) / 2 - 0.01);
TRAY_OUTLINE = rect_points(TRAY[0], TRAY[1], TRAY_RADIUS, segments_for(TRAY_RADIUS * 2, 32));
RECESS_OUTLINE =
  ROUND ? circle_points(RECESS_RADIUS, segments_for(SLOT_WIDTH, 64))
  : rect_points(RECESS[0], RECESS[1], RECESS_RADIUS, segments_for(RECESS_RADIUS * 2, 32));

// Magnet counts and centres, ported from presets.ts and base.ts as holder.ts applies them to a slot.
function magnets_ring(w, l) = max(w, l) / min(w, l) <= 1.35;
function spread_count(ideal, counts) = let(fits = [for (c = counts) if (c <= ideal) c]) len(fits) > 0 ? max(fits) : counts[0];
function ring_magnet_count(short) = spread_count(PI * short / 2 / MAGNET_PITCH, RING_COUNTS);
function legacy_magnet_count(w, l, max_count) =
  let(short = min(w, l), long = max(w, l))
  short < 20 ? 0
  : w * l <= 40 * 40 && long <= SINGLE_MAGNET_MAX_SPAN ? 1
  : magnets_ring(w, l) ? min(ring_magnet_count(short), max_count)
  : let(run = long - 8, transverse = ring_magnet_count(short))
    run <= MAGNET_PITCH * END_PAIR_PITCHES && short <= SINGLE_MAGNET_MAX_SPAN && transverse == 3 ? min(2, max_count)
    : let(minimum = transverse % 2 == 0 ? transverse : transverse - 1,
          natural = max(minimum, spread_count(run / MAGNET_PITCH + 1, ROW_COUNTS)))
      spread_count(min(natural, max_count), ROW_LIMIT_COUNTS);
function next_supported_count(ideal, counts, max_count) =
  let(available = [for (c = counts) if (c <= max_count) c], above = [for (c = available) if (c >= ideal) c])
  len(above) > 0 ? above[0] : len(available) > 0 ? available[len(available) - 1] : 0;
function automatic_magnet_count(w, l, max_count, diameter, thickness) =
  let(baseline = legacy_magnet_count(w, l, max_count))
  baseline <= 1 ? baseline
  : let(demand = ceil(baseline * DEFAULT_MAGNET_STRENGTH / (diameter ^ 2 * thickness)))
    magnets_ring(w, l) ? next_supported_count(max(3, demand), RING_COUNTS, max_count)
    : next_supported_count(max(2, demand), ROW_LIMIT_COUNTS, max_count);

function magnet_positions(count, hw, hl, clear, five_cross) =
  count <= 0 ? []
  : let(short = min(hw, hl), radius = max(min(short * 0.5, short - clear), 0))
    five_cross ? [[0, 0], [0, radius], [-radius, 0], [0, -radius], [radius, 0]]
    : count == 1 ? [[0, 0]]
    : !magnets_ring(hw, hl)
      ? let(reach = max(max(hw, hl) - clear, 0))
        [for (i = [0:count - 1]) let(t = 2 * i / (count - 1) - 1) hw >= hl ? [t * reach, 0] : [0, t * reach]]
      : [for (i = [0:count - 1]) let(a = 90 + 360 * i / count) [radius * cos(a), radius * sin(a)]];

FIVE_CROSS = pocket_layout == "five-cross" && ROUND && WIDTH >= 50;
MAGNET_COUNT =
  !slot_magnets ? 0
  : FIVE_CROSS ? 5
  : magnets_per_base == "auto" ? automatic_magnet_count(WIDTH, LENGTH, MAX_MAGNETS, magnet_diameter, magnet_thickness)
  : [for (c = [0:MAX_MAGNETS]) if (str(c) == magnets_per_base) c][0];
POCKET_RADIUS = (magnet_diameter + magnet_diameter_clearance) / 2;
MAGNETS = magnet_positions(
  MAGNET_COUNT,
  max(0, WIDTH / 2 - base_wall_thickness),
  max(0, LENGTH / 2 - base_wall_thickness),
  POCKET_RADIUS + base_wall_around_pocket + LABEL_MARGIN,
  FIVE_CROSS
);
POCKET = circle_points(POCKET_RADIUS, segments_for(POCKET_RADIUS * 2, 32));

module movement_tray() {
  difference() {
    linear_extrude(HEIGHT) polygon(TRAY_OUTLINE);
    translate([0, 0, floor_thickness]) linear_extrude(slot_depth + 1)
      if (ROUND) for (s = SLOTS) translate(s) polygon(RECESS_OUTLINE);
      else polygon(RECESS_OUTLINE);
    if (len(MAGNETS) > 0) translate([0, 0, floor_thickness - POCKET_DEPTH]) linear_extrude(POCKET_DEPTH + 0.01)
      for (s = SLOTS, m = MAGNETS) translate(s + m) polygon(POCKET);
  }
}

movement_tray();
