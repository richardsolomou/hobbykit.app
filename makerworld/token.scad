// HobbyKit tabletop gaming token, for MakerWorld's Parametric Model Maker.
// A port of src/core/geometry/token.ts, text only: change both together, then run `just makerworld check`.
// Tokens print face up: z = 0 is the table face on the build plate, raised text stands on z = thickness
// as a second part for a second filament, and engraved text is cut down from that face.
// Licensed under CC BY-SA 4.0, unlike the AGPL-3.0-only app, because MakerWorld offers no GPL licence.

/* [Text] */
// Wraps onto up to three lines and shrinks to fit the face. Leave empty for a plain token.
token_text = "Objective";
// Requested cap height in mm; long text shrinks below it, but never below 1.5mm.
text_height = 20; // [1.5:0.5:60]

/* [Relief] */
// Raised text prints in a second filament; engraved text lets tokens stack flat.
relief = "raised"; // [raised:Raised, engraved:Engraved, none:None]
// Engraving always leaves at least 1mm beneath the text.
relief_depth = 1; // [0.1:0.1:3]

/* [Body] */
shape = "round"; // [round:Round, square:Square, hex:Hex]
// Measured across the flats: a round's diameter, a square's width, a hex's flat-to-flat distance.
size = 40; // [15:0.1:120]
// Corner rounding for squares.
corner_radius = 3; // [0:0.5:60]
thickness = 3; // [1:0.1:10]
top_edge = "bevel"; // [taper:Taper, bevel:Bevel, round:Round, straight:Straight]
edge_size = 0.6; // [0:0.1:3]

/* [Export] */
// Raised text is a separate part: export the body and the text apart to give each its own filament.
part = "all"; // [all:Body and text, body:Body, text:Text]

/* [Hidden] */
TEXT_MAX_LENGTH = 40;
MIN_TEXT_HEIGHT = 1.5;
FACE_MARGIN = 1.5;
LINE_PITCH = 1.3;
MAX_LINES = 3;
EXPORT_CURVE_TOLERANCE = 0.001;
// The rest of the hull is exact; each loft slice is this thin.
SLICE = 0.001;

// <generated by scripts/makerworld.ts: glyphs outlines>
UNITS_PER_EM = 1000;
