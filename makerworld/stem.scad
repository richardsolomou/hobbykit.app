// HobbyKit flying stem, for MakerWorld's Parametric Model Maker.
// A port of src/core/geometry/stem.ts: change both together, then run `just makerworld check`.
// The stem prints upright from its flat foot, which is glued to the base; the top joins the miniature.
// Licensed under CC BY-SA 4.0, unlike the AGPL-3.0-only app, because MakerWorld offers no GPL licence.

/* [Stem] */
// Height of the tapered body, without the connection. Classic stems are 15, 20, 30 or 35mm.
stem_height = 15; // [2:0.5:60]
// Diameter of the foot. It must be at least as wide as the connection's neck.
body_diameter = 4.8; // [1:0.1:8]

/* [Miniature Connection] */
connection = "peg"; // [peg:Peg, ball:Ball joint]
// Peg only: match the hole drilled in the miniature.
model_peg_diameter = 1.8; // [1:0.1:4]
// Peg only.
model_peg_length = 4; // [1:0.1:8]
// Ball joint only. The body tapers to half this diameter.
ball_diameter = 4; // [2:0.1:8]

/* [Hidden] */
EXPORT_CURVE_TOLERANCE = 0.001;
JOIN_OVERLAP = 0.05;

// <generated by scripts/makerworld.ts: >
// </generated>

PEG = connection == "peg";
NECK = PEG ? model_peg_diameter : ball_diameter / 2;
function segments_for_tolerance(diameter, tolerance) = diameter / 2 <= tolerance ? 3 : ceil(180 / acos(1 - tolerance / (diameter / 2)));
SEGMENTS =
  assert(connection == "peg" || connection == "ball", str("Unknown connection ", connection))
  assert(stem_height >= 2, "Flying-stem body must be at least 2 mm tall")
  assert(body_diameter >= NECK, "Flying-stem body must be at least as wide as its miniature connection")
  assert(!PEG || model_peg_length > 0, "Flying-stem mounting peg needs a positive length")
  assert(PEG || ball_diameter > 0, "Flying-stem ball joint needs a positive diameter")
  segments_for_tolerance(max(body_diameter, PEG ? 0 : ball_diameter), EXPORT_CURVE_TOLERANCE);

module stem() {
  cylinder(h = stem_height, r1 = body_diameter / 2, r2 = NECK / 2, $fn = SEGMENTS);
  if (PEG) translate([0, 0, stem_height - JOIN_OVERLAP]) cylinder(h = model_peg_length + JOIN_OVERLAP, r = NECK / 2, $fn = SEGMENTS);
  else translate([0, 0, stem_height + ball_diameter / 2 - JOIN_OVERLAP]) sphere(d = ball_diameter, $fn = SEGMENTS);
}

stem();
