// HobbyKit magnetic spray painting tray and glue-on handle, for MakerWorld's Parametric Model Maker.
// A port of src/core/geometry/paintingTray.ts: change both together, then run `just makerworld check`.
// The tray prints flat with its magnet pockets opening on top and the engraved + on the underside,
// where the handle's flat end is glued. The handle prints upright on that flat end, never fused to the tray.
// Licensed under CC BY-SA 4.0, unlike the AGPL-3.0-only app, because MakerWorld offers no GPL licence.

/* [Parts] */
// Both lays the tray and the handle side by side, each the way it prints.
part = "both"; // [both:Tray and handle, tray:Tray only, handle:Handle only]

/* [Magnet Grid] */
columns = 4; // [1:1:12]
rows = 4; // [1:1:12]
// Centre-to-centre distance between neighbouring pockets in a row. An offset pocket sits between every four.
centre_spacing = 50; // [4:0.5:80]
// From an outer pocket's centre to the tray edge.
edge_margin = 12; // [2:0.5:40]

/* [Construction] */
// Must leave 0.9mm under the pockets: the floor plus the engraved +.
tray_thickness = 3; // [1.5:0.1:8]

/* [Magnets] */
magnet_diameter = 5; // [2:0.5:8]
magnet_thickness = 2; // [0.5:0.1:5]
magnet_diameter_clearance = 0.2; // [0:0.05:0.6]
// Room behind each magnet for adhesive.
magnet_depth_clearance = 0.1; // [0:0.05:0.5]

/* [Handle] */
grip_shape = "round"; // [round:Round, oval:Oval barrel, flared:Flared base, pistol:Pistol grip]
grip_length = 100; // [60:5:120]
grip_width = 28; // [20:1:40]
// Tilts the grip off vertical.
lean_angle = 0; // [0:1:30]
// Softens the end that rests in the hand.
rounded_end = false;
grip_ribs = false;

/* [Hidden] */
CORNER_RADIUS = 6;
MIN_FLOOR_THICKNESS = 0.6;
MIN_POCKET_WEB = 0.8;
HANDLE_RIB_COUNT = 8;
CENTER_MARK_DEPTH = 0.3;
CENTER_MARK_WIDTH = 1;
CENTER_MARK_CLEARANCE = 8;
EXPORT_CURVE_TOLERANCE = 0.001;
// Space between the tray and the handle when both are laid out.
PART_GAP = 10;

// <generated by scripts/makerworld.ts: >
// </generated>

function segments_for_tolerance(diameter, tolerance) = diameter / 2 <= tolerance ? 3 : ceil(180 / acos(1 - tolerance / (diameter / 2)));
function curve_tolerance(diameter, segments) = diameter / 2 * (1 - cos(180 / segments));
// Each part derives its tolerance from its export segment count; small circles keep a preview minimum below 257.
function segments_for(diameter, minimum, segments, tolerance) = max(segments <= 256 ? minimum : 3, segments_for_tolerance(diameter, tolerance));
function circle_points(r, n) = [for (i = [0:n - 1]) [r * cos(360 * i / n), r * sin(360 * i / n)]];
// A rectangle grown from an inner one by a Clipper round offset, vertex for vertex what Manifold builds.
function rect_points(w, l, radius, n) =
  let(k = max(1, ceil(n / 4)), cx = w / 2 - radius, cy = l / 2 - radius)
  [for (q = [0:3]) let(sx = q == 0 || q == 3 ? 1 : -1, sy = q < 2 ? 1 : -1)
    for (j = [0:k]) let(a = 90 * q + 90 * j / k) [sx * cx + radius * cos(a), sy * cy + radius * sin(a)]];

// Tray.
COLUMNS = max(1, round(columns));
ROWS = max(1, round(rows));
TRAY_WIDTH = (COLUMNS - 1) * centre_spacing + edge_margin * 2;
TRAY_LENGTH = (ROWS - 1) * centre_spacing + edge_margin * 2;
POCKET_RADIUS = (magnet_diameter + magnet_diameter_clearance) / 2;
POCKET_DEPTH = magnet_thickness + magnet_depth_clearance;
MAGNETS = concat(
  [for (r = [0:ROWS - 1]) for (c = [0:COLUMNS - 1]) [(c - (COLUMNS - 1) / 2) * centre_spacing, (r - (ROWS - 1) / 2) * centre_spacing]],
  [for (r = [0:1:ROWS - 2]) for (c = [0:1:COLUMNS - 2]) [(c - (COLUMNS - 2) / 2) * centre_spacing, (r - (ROWS - 2) / 2) * centre_spacing]]
);
TRAY_SEGMENTS = segments_for_tolerance(max(TRAY_WIDTH, TRAY_LENGTH), EXPORT_CURVE_TOLERANCE);
TRAY_TOLERANCE = curve_tolerance(max(TRAY_WIDTH, TRAY_LENGTH), TRAY_SEGMENTS);
TRAY_RADIUS = min(CORNER_RADIUS, TRAY_WIDTH / 2 - 0.01, TRAY_LENGTH / 2 - 0.01);
TRAY_OUTLINE = rect_points(TRAY_WIDTH, TRAY_LENGTH, TRAY_RADIUS, segments_for(TRAY_RADIUS * 2, 32, TRAY_SEGMENTS, TRAY_TOLERANCE));
POCKET_SEGMENTS = segments_for(POCKET_RADIUS * 2, 32, TRAY_SEGMENTS, TRAY_TOLERANCE);
// The + reaches past the grip, ribs included, so it shows round the glued end.
CENTER_MARK_SPAN = grip_width + (grip_ribs ? min(2.4, grip_width * 0.08) : 0) + CENTER_MARK_CLEARANCE;

MIN_HEIGHT = POCKET_DEPTH + MIN_FLOOR_THICKNESS + CENTER_MARK_DEPTH;
MIN_SPACING = (magnet_diameter + magnet_diameter_clearance + MIN_POCKET_WEB) * sqrt(2);
MIN_MARGIN = POCKET_RADIUS + MIN_POCKET_WEB;
TRAY_CHECKED = part == "handle" ? true
  : assert(tray_thickness >= MIN_HEIGHT - 1e-9, str("Tray thickness leaves too little material below the magnet pockets — use at least ", MIN_HEIGHT, "mm"))
    assert(centre_spacing >= MIN_SPACING - 1e-9, str("Centre spacing leaves too little material between diagonal pockets — use at least ", ceil(MIN_SPACING * 2) / 2, "mm"))
    assert(edge_margin >= MIN_MARGIN - 1e-9, str("Edge margin leaves too little material beside the outer pockets — use at least ", MIN_MARGIN, "mm"))
    true;

module tray() {
  difference() {
    linear_extrude(tray_thickness) polygon(TRAY_OUTLINE);
    translate([0, 0, -0.001]) linear_extrude(CENTER_MARK_DEPTH + 0.001) {
      square([CENTER_MARK_SPAN, CENTER_MARK_WIDTH], center = true);
      square([CENTER_MARK_WIDTH, CENTER_MARK_SPAN], center = true);
    }
    for (m = MAGNETS) translate([m[0], m[1], tray_thickness - POCKET_DEPTH])
      cylinder(r = POCKET_RADIUS, h = POCKET_DEPTH + 0.001, $fn = POCKET_SEGMENTS);
  }
}

// Handle.
HANDLE_SCALE = grip_shape == "oval" ? 1.12 : grip_shape == "flared" ? 1.25 : grip_shape == "pistol" ? 1.08 : 1;
HANDLE_DEPTH = grip_shape == "oval" ? grip_width * 0.75 : grip_width;
LEAN = tan(lean_angle);
RIB_ALLOWANCE = grip_ribs ? min(2.4, grip_width * 0.08) : 0;
PISTOL_CURVE = grip_shape == "pistol" ? grip_width * 0.22 : 0;
HANDLE_SPAN = max(
  grip_width * HANDLE_SCALE + RIB_ALLOWANCE + abs(grip_length * LEAN) + PISTOL_CURVE,
  HANDLE_DEPTH * HANDLE_SCALE + RIB_ALLOWANCE
);
HANDLE_SEGMENTS = segments_for_tolerance(HANDLE_SPAN, EXPORT_CURVE_TOLERANCE);
HANDLE_TOLERANCE = curve_tolerance(HANDLE_SPAN, HANDLE_SEGMENTS);
RIB_RADIUS = min(1.2, grip_width * 0.04);
GRIP_PROFILE = [for (p = circle_points(grip_width / 2, segments_for(grip_width, 32, HANDLE_SEGMENTS, HANDLE_TOLERANCE))) [p[0], p[1] * HANDLE_DEPTH / grip_width]];
RIB_PROFILE = circle_points(RIB_RADIUS, segments_for(RIB_RADIUS * 2, 12, HANDLE_SEGMENTS, HANDLE_TOLERANCE));
// The cross-section as convex pieces whose union is the app's profile; each one lofts on its own.
PROFILES = concat([GRIP_PROFILE], grip_ribs
  ? [for (i = [0:HANDLE_RIB_COUNT - 1]) let(a = 360 * i / HANDLE_RIB_COUNT, c = [grip_width / 2 * cos(a), HANDLE_DEPTH / 2 * sin(a)]) [for (p = RIB_PROFILE) p + c]]
  : []);

// The app extrudes the profile in 21 layers when it has to shape it and warps each vertex. Each layer maps the
// profile by a uniform scale and a shift in x, so edges stay parallel and the loft between layers is exact.
LAYERS = grip_shape != "round" || rounded_end ? 21 : 1;
function swell(position) =
  grip_shape == "oval" ? 1 + 0.12 * sin(180 * position)
  : grip_shape == "flared" ? 1 + 0.25 * max(0, 1 - position / 0.25)
  : grip_shape == "pistol" ? 1 + 0.08 * sin(180 * position)
  : 1;
// [z, scale, shift] for each layer, from the end the handle stands on.
WARPS = [for (i = [0:LAYERS]) let(z = grip_length * i / LAYERS, position = z / grip_length)
  [z, swell(position) * (rounded_end && position < 0.05 ? 0.86 + 2.8 * position : 1), z * LEAN - PISTOL_CURVE * sin(180 * position)]];

ALL_POINTS = [for (profile = PROFILES) each profile];
PROFILE_X = [min([for (p = ALL_POINTS) p[0]]), max([for (p = ALL_POINTS) p[0]])];
PROFILE_Y = [min([for (p = ALL_POINTS) p[1]]), max([for (p = ALL_POINTS) p[1]])];
HANDLE_X = [min([for (w = WARPS) w[1] * PROFILE_X[0] + w[2]]), max([for (w = WARPS) w[1] * PROFILE_X[1] + w[2]])];
HANDLE_Y = [min([for (w = WARPS) w[1] * PROFILE_Y[0]]), max([for (w = WARPS) w[1] * PROFILE_Y[1]])];
HANDLE_WIDTH = HANDLE_X[1] - HANDLE_X[0];

module loft(profile) {
  n = len(profile);
  polyhedron(
    points = [for (w = WARPS) for (p = profile) [p[0] * w[1] + w[2], p[1] * w[1], w[0]]],
    faces = concat(
      [[for (j = [0:n - 1]) j]],
      [[for (j = [n - 1:-1:0]) LAYERS * n + j]],
      [for (k = [0:LAYERS - 1]) for (j = [0:n - 1]) [k * n + j, (k + 1) * n + j, (k + 1) * n + (j + 1) % n, k * n + (j + 1) % n]]
    )
  );
}

// Centred on the plate the way the app exports it.
module handle() {
  translate([-(HANDLE_X[0] + HANDLE_X[1]) / 2, -(HANDLE_Y[0] + HANDLE_Y[1]) / 2, 0]) union() for (profile = PROFILES) loft(profile);
}

if (part == "tray") tray();
else if (part == "handle") handle();
else {
  tray();
  translate([TRAY_WIDTH / 2 + PART_GAP + HANDLE_WIDTH / 2, 0, 0]) handle();
}
