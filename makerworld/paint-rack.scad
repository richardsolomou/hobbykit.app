// HobbyKit modular paint rack, for MakerWorld's Parametric Model Maker.
// A port of src/core/geometry/paintRack.ts: change both together, then run `just makerworld check`.
// This script builds one straight module with optional ends; the app also chains modules and turns corners.
// Every cell is a hex tube standing on the plate, its walls shared with its neighbours, capped by a thin
// deck with a bore for a dropper and an optional pocket above it for a pot. It prints upright with supports off.
// Licensed under CC BY-SA 4.0, unlike the AGPL-3.0-only app, because MakerWorld offers no GPL licence.

/* [Pieces] */
// Print every piece side by side, or one piece on its own.
part = "all"; // [all:All pieces, module:Module, left-end:Left end, right-end:Right end]
// Bottles across the module.
columns = 5; // [1:1:10]
// Rows of every piece, each standing higher than the one in front.
rows = 4; // [1:1:6]
// Ends add cells that step each side back with the rows. They need two rows on the left, three on the right.
left_end = false;
right_end = false;

/* [Cells] */
// Centre-to-centre distance across a row, which is also each cell's size across its flats.
cell_size = 35; // [22:0.5:50]

/* [Steps] */
// Height of the front row's deck, below its pot pocket.
front_deck_height = 17; // [3:0.5:60]
rise_per_row = 26; // [0:0.5:40]

/* [Pot pockets] */
// Round pocket above each deck that holds a pot. 0 leaves flat decks, which print faster.
pocket_depth = 5; // [0:0.5:20]
pocket_diameter = 33.3; // [20:0.1:49]

/* [Dropper seats] */
// Bore through each deck that holds a dropper bottle.
seat_diameter = 26; // [9:0.5:45]
// Depth of the bore, down to the ledge the bottle stands on.
seat_depth = 16; // [2:0.5:58]
// Hole through the ledge to push a stuck bottle out.
push_out_hole = 19.5; // [8:0.5:44]
wall_thickness = 0.85; // [0.8:0.05:2]

/* [Hidden] */
MIN_WALL = 0.8;
// Clearance between the facing walls of neighbouring pieces, so separately printed pieces still slot together.
PIECE_CLEARANCE = 0.2;
DECK = 0.8;
RIM = 0.8;
POCKET_CLEARANCE = 0.3;
// Between pieces laid out for printing together.
PLATE_GAP = 5;
EXPORT_CURVE_TOLERANCE = 0.001;
SQRT3 = sqrt(3);

// <generated by scripts/makerworld.ts: >
// </generated>

PITCH = cell_size;
WALL = wall_thickness;
ROWS = max(1, round(rows));
COLUMNS = max(1, round(columns));
ROW_PITCH = PITCH * SQRT3 / 2;
CORNER_RADIUS = (PITCH + WALL) / SQRT3;
PIECE_GAP = (WALL + PIECE_CLEARANCE) * 2;
HOLE_RADIUS = push_out_hole / 2;
SEAT_RADIUS = seat_diameter / 2;
INNER_APOTHEM = (PITCH - WALL) / 2;
POCKET_RADIUS = pocket_diameter / 2;

CHECKED =
  assert(WALL >= MIN_WALL - 1e-9, "Rack walls are too thin to print")
  assert(SEAT_RADIUS + WALL < INNER_APOTHEM, "Bottle seat must fit inside its cell")
  assert(HOLE_RADIUS > WALL && HOLE_RADIUS < SEAT_RADIUS, "Push-out hole must be narrower than the seat")
  assert(seat_depth >= DECK + WALL, "Bottle seat is too shallow for the deck")
  assert(pocket_depth <= 0 || (POCKET_RADIUS > SEAT_RADIUS + WALL && POCKET_RADIUS <= INNER_APOTHEM - POCKET_CLEARANCE + 1e-9),
    "Pot pocket must sit between the seat and the walls")
  assert(front_deck_height >= seat_depth + WALL, "Front row is too low for its bottle seat")
  true;

// Odd rows sit half a cell right, so the cells tile as a honeycomb and neighbouring pieces interlock.
function lattice_x(column, row) = column * PITCH + (row % 2 == 0 ? 0 : PITCH / 2);
// [x, y, row]
function cell(x, row) = [x, row * ROW_PITCH, row];

MODULE_CELLS = [for (row = [0:ROWS - 1]) for (column = [0:COLUMNS - 1]) cell(lattice_x(column, row), row)];
// An end adds a cell to every row for each two behind the front, stepping the side back at the lattice's 60°.
LEFT_CELLS = [for (row = [0:ROWS - 1]) for (i = [0:1:ceil(row / 2) - 1]) cell(lattice_x(-1 - i, row) - PIECE_GAP, row)];
RIGHT_CELLS = [for (row = [0:ROWS - 1]) for (i = [0:1:floor(row / 2) - 1]) cell(lattice_x(i, row) + COLUMNS * PITCH + PIECE_GAP, row)];
// [kind, cells], left to right.
PIECES = [
  if (left_end && len(LEFT_CELLS) > 0) ["left-end", LEFT_CELLS],
  ["module", MODULE_CELLS],
  if (right_end && len(RIGHT_CELLS) > 0) ["right-end", RIGHT_CELLS],
];

// [minX, maxX, minY, maxY] of the cells' outer hexes, which bound everything else.
function bounds(cells) = [
  min([for (c = cells) c[0]]) - (PITCH + WALL) / 2,
  max([for (c = cells) c[0]]) + (PITCH + WALL) / 2,
  min([for (c = cells) c[1]]) - CORNER_RADIUS,
  max([for (c = cells) c[1]]) + CORNER_RADIUS,
];
LOADOUT = bounds([for (p = PIECES) each p[1]]);
LOADOUT_WIDTH = LOADOUT[1] - LOADOUT[0];
LOADOUT_LENGTH = LOADOUT[3] - LOADOUT[2];

// The app picks curve segments from the whole loadout's size, so every piece matches its own export.
function segments_for_tolerance(diameter, tolerance) = diameter / 2 <= tolerance ? 3 : ceil(180 / acos(1 - tolerance / (diameter / 2)));
SEGMENTS = segments_for_tolerance(max(LOADOUT_WIDTH, LOADOUT_LENGTH), EXPORT_CURVE_TOLERANCE);
TOLERANCE = LOADOUT_WIDTH / 2 * (1 - cos(180 / SEGMENTS));
function circle_segments(radius) = max(SEGMENTS <= 256 ? 48 : 3, segments_for_tolerance(radius * 2, TOLERANCE));

function row_height(row) = front_deck_height + row * rise_per_row + pocket_depth;
// Where the funnel's underside meets the walls' corners, below the deck's top.
FUNNEL_DROP = seat_depth + (PITCH - WALL) / SQRT3 - SEAT_RADIUS + WALL;
FAR = CORNER_RADIUS + 1;
TUBE = SEAT_RADIUS + WALL;
CHAMFER = CORNER_RADIUS - POCKET_RADIUS + 1;
POCKET_SEGMENTS = circle_segments(POCKET_RADIUS);
FLOOR_HOLE_RADIUS = HOLE_RADIUS - WALL;

module hexagon(flats) rotate(90) circle(r = flats / SQRT3, $fn = 6);

// Measured down from the deck's top: the bore tube, and a 45° funnel whose upper face is the dropper's ledge
// and whose lower face spreads to the walls. The tube tops out inside the deck so no two faces coincide.
function seat_top(radius) = -seat_depth - (radius - SEAT_RADIUS);
module seat() {
  rotate_extrude($fn = circle_segments(FAR)) polygon([
    [HOLE_RADIUS, seat_top(HOLE_RADIUS) - WALL],
    [FAR, seat_top(FAR) - WALL],
    [FAR, seat_top(FAR)],
    [TUBE, seat_top(TUBE)],
    [TUBE, -DECK / 2],
    [SEAT_RADIUS, -DECK / 2],
    [SEAT_RADIUS, seat_top(SEAT_RADIUS)],
    [HOLE_RADIUS, seat_top(HOLE_RADIUS)],
  ]);
}

// The pocket is the hex cell itself, rounded only by a rim whose underside chamfers out to the walls at 45°.
module pocket_void(deck, height) {
  rim = height - RIM;
  intersection() {
    union() {
      translate([0, 0, rim - 1]) cylinder(h = RIM + 2, r = POCKET_RADIUS, $fn = POCKET_SEGMENTS);
      translate([0, 0, rim - CHAMFER]) cylinder(h = CHAMFER + 1, r1 = POCKET_RADIUS + CHAMFER, r2 = POCKET_RADIUS - 1, $fn = POCKET_SEGMENTS);
      translate([0, 0, deck - 1]) cylinder(h = max(1, rim - CHAMFER + 1.5 - deck), r = POCKET_RADIUS + CHAMFER, $fn = POCKET_SEGMENTS);
    }
    translate([0, 0, deck]) linear_extrude(height + 1 - deck) hexagon(PITCH - WALL);
  }
}

// A funnel that would reach the plate before the walls' corners lands on a floor instead of floating.
function floored(deck) = deck - FUNNEL_DROP < WALL * 2;

module cell_voids(height) {
  deck = height - pocket_depth;
  hollow = floored(deck) ? WALL : -1;
  translate([0, 0, hollow]) linear_extrude(deck - DECK - hollow) hexagon(PITCH - WALL);
  translate([0, 0, deck - DECK - 1]) cylinder(h = DECK + 2, r = SEAT_RADIUS + WALL / 2, $fn = circle_segments(TUBE));
  if (pocket_depth > 0) pocket_void(deck, height);
  if (floored(deck)) translate([0, 0, -1]) cylinder(h = WALL + 2, r = FLOOR_HOLE_RADIUS, $fn = circle_segments(FLOOR_HOLE_RADIUS));
}

// Seats reach the middle of the walls rather than stopping at their faces, which would leave them tangent.
module cell_seat(height) {
  deck = height - pocket_depth;
  base = floored(deck) ? WALL / 2 : 0;
  intersection() {
    translate([0, 0, deck]) seat();
    translate([0, 0, base]) linear_extrude(deck - base) hexagon(PITCH);
  }
}

module piece(cells) {
  union() {
    difference() {
      union() for (c = cells) translate([c[0], c[1]]) linear_extrude(row_height(c[2])) hexagon(PITCH + WALL);
      for (c = cells) translate([c[0], c[1]]) cell_voids(row_height(c[2]));
    }
    for (c = cells) translate([c[0], c[1]]) cell_seat(row_height(c[2]));
  }
}

// Each piece centred on its own footprint, as the app exports it.
module centred(cells) {
  b = bounds(cells);
  translate([-(b[0] + b[1]) / 2, -(b[2] + b[3]) / 2]) piece(cells);
}

function sum(values, i = 0) = i >= len(values) ? 0 : values[i] + sum(values, i + 1);
WIDTHS = [for (p = PIECES) let(b = bounds(p[1])) b[1] - b[0]];
ROW_WIDTH = sum(WIDTHS) + PLATE_GAP * (len(PIECES) - 1);

if (part == "all") {
  for (i = [0:len(PIECES) - 1])
    translate([-ROW_WIDTH / 2 + sum([for (j = [0:1:i - 1]) WIDTHS[j] + PLATE_GAP]) + WIDTHS[i] / 2, 0]) centred(PIECES[i][1]);
} else {
  chosen = [for (p = PIECES) if (p[0] == part) p];
  assert(len(chosen) == 1, str("Turn on the ", part == "left-end" ? "left" : "right", " end, with enough rows for it"));
  centred(chosen[0][1]);
}
