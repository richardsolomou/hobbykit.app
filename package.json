{
  "name": "hobbykit",
  "version": "0.27.0",
  "private": true,
  "description": "Parametric generator for tabletop hobby prints: magnetised miniature bases, holders, trays, paint racks, and tokens.",
  "homepage": "https://hobbykit.app",
  "bugs": "https://github.com/richardsolomou/hobbykit.app/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/hobbykit.app.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "samples": "tsx scripts/exportSamples.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@posthog/react": "^1.11.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "driver.js": "^1.14.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.73.0",
    "manifold-3d": "^3.5.5",
    "opentype.js": "^2.0.0",
    "posthog-js": "^1.453.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "^1.65.1",
    "@posthog/rollup-plugin": "^1.6.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.2.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ras-stack": "^6.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.13.0"
}
